# Ignore all files and directories by default
/*

# Whitelist ONLY files needed for the public web app
!/.gitignore
!/.gitattributes
!/README.md
!/index.html
!/favicon.ico
!/favicon.png

# Whitelist asset/js/qrcode.min.js and asset/fonts/
!/asset/
/asset/*
!/asset/js/
/asset/js/*
!/asset/js/qrcode.min.js
!/asset/fonts/
/asset/fonts/*
!/asset/fonts/*.ttf

# Whitelist /hmong web app
!/hmong/
!/hmong/**

# Whitelist /lao web app
!/lao/
!/lao/**

# Whitelist /script specific files
!/script/data_boundary*
!/script/render_all_boundary_plots.js
!/script/enrich_boundary_doctrine.js
!/script/atlas_encyclopedia_content.js
!/script/build_master_atlas_encyclopedia_docx.js
!/script/build_hmong_web_portal.js
!/script/build_lao_web_portal.js



