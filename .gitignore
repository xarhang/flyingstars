# Ignore all files and directories by default
/*

# Whitelist ONLY files needed for the public web app
!/.gitignore
!/.gitattributes
!/README.md
!/index.html
!/favicon.ico
!/favicon.png
!/img/
!/img/**

# Whitelist asset/js/qrcode.min.js, asset/fonts/, and asset/vendor/
!/asset/
/asset/*
!/asset/js/
/asset/js/*
!/asset/js/qrcode.min.js
!/asset/fonts/
/asset/fonts/*
!/asset/fonts/*.ttf
!/asset/vendor/
!/asset/vendor/**

# Whitelist /hmong web app
!/hmong/
!/hmong/**

# Whitelist /lao web app
!/lao/
!/lao/**

# Whitelist /monographs
!/monographs/
!/monographs/**

# Whitelist /script specific files
!/script/
/script/*
!/script/data_boundary*
!/script/data_16_core_land_plot*
!/script/data_75_core_luan_tou*
!/script/render_all_boundary_plots.js
!/script/enrich_boundary_doctrine.js
!/script/atlas_encyclopedia_content.js
!/script/build_master_atlas_encyclopedia_docx.js
!/script/build_hmong_web_portal.js
!/script/build_lao_web_portal.js
!/script/build_pahawh_web_portal.js
!/script/rpa_to_pahawh_converter.js
!/script/render_monograph_html.js

# Whitelist /pahawh web app
!/pahawh/
!/pahawh/**



